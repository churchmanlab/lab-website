---
import "../styles/global.css";
import site from "../data/site.json";
import { u } from "../lib/path.js";

const { title, description, jsonld = [], image } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const fullTitle = path === "/" ? `${site.name} — ${site.institution}` : `${title} — ${site.name}`;
const canonical = new URL(path, site.url).href;

// Every page carries the lab's identity graph so assistants and search engines
// resolve "Churchman Lab" to the right organisation and person.
const orgGraph = {
  "@context": "https://schema.org",
  "@type": "ResearchOrganization",
  "@id": `${site.url}/#lab`,
  name: site.name,
  alternateName: "Churchman Laboratory",
  url: site.url,
  description: site.tagline,
  parentOrganization: {
    "@type": "CollegeOrUniversity",
    name: site.institution,
    url: "https://hms.harvard.edu/",
  },
  department: { "@type": "Organization", name: site.department },
  address: {
    "@type": "PostalAddress",
    streetAddress: `${site.address.line1}, ${site.address.line2}`,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    postalCode: site.address.zip,
    addressCountry: site.address.country,
  },
  employee: { "@id": `${site.url}/stirling#person` },
  sameAs: [site.links.googleScholar, site.links.github],
};

const blocks = [orgGraph, ...(Array.isArray(jsonld) ? jsonld : [jsonld])].filter(Boolean);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="text/plain" href={u("/llms.txt")} title="Plain-text summary for AI assistants" />
    {blocks.map((b) => (
      <script type="application/ld+json" set:html={JSON.stringify(b)} />
    ))}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={u("/")}>Churchman Lab</a>
        <nav class="site-nav" aria-label="Primary">
          {site.nav.map((n) => (
            <a href={u(n.href)} aria-current={path === n.href || path.startsWith(n.href + "/") ? "page" : undefined}>
              {n.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <h4>Churchman Lab</h4>
            <p style="font-size:.9rem;color:var(--ink-2);max-width:34ch;margin:0">
              {site.department}<br />
              {site.division}, {site.institution}<br />
              {site.address.line1}<br />
              {site.address.line2}<br />
              {site.address.city}, {site.address.state} {site.address.zip}
            </p>
          </div>
          <div>
            <h4>Explore</h4>
            <ul>
              <li><a href={u("/research")}>Research</a></li>
              <li><a href={u("/team")}>Team</a></li>
              <li><a href={u("/publications")}>Publications</a></li>
              <li><a href={u("/tools")}>Tools &amp; protocols</a></li>
              <li><a href={u("/fun")}>Lab life</a></li>
            </ul>
          </div>
          <div>
            <h4>Elsewhere</h4>
            <ul>
              <li><a href={site.links.github}>GitHub</a></li>
              <li><a href={site.links.googleScholar}>Google Scholar</a></li>
              <li><a href={site.links.ncbiBibliography}>NCBI bibliography</a></li>
              <li><a href={site.links.x}>@fiddle</a></li>
              <li><a href={u("/join")}>Join the lab</a></li>
            </ul>
          </div>
        </div>
        <div class="colophon">
          <span>Paintings by <a href="https://matthewmarks.com/artists/leidy-churchman">Leidy Churchman</a>.</span>
          <span>Prototype rebuild — <a href={u("/llms.txt")}>llms.txt</a></span>
        </div>
      </div>
    </footer>
  </body>
</html>
