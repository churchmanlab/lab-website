---
import Base from "../layouts/Base.astro";
import site from "../data/site.json";
import pubs from "../data/publications.json";
import { u } from "../lib/path.js";

const img = (p, w = 1200) => `${site.cdn}${p}?format=${w}w`;

const highlights = [
  {
    title: "How RNA flows through the cell",
    blurb:
      "From synthesis and chromatin release to nuclear export, ribosome engagement and eventual degradation, we quantified the lives of human transcripts genome-wide — and found that hundreds of genes are degraded in the nucleus and never exported at all.",
    img: "/495c8095-5a22-4ed6-96ff-00c645c70182/tweet+image.png",
    href: "/research#mrna-life-cycle",
    cite: "Ietswaart et al., Molecular Cell 2024",
  },
  {
    title: "Single-molecule views of transcription and chromatin",
    blurb:
      "Long-read chromatin fiber sequencing lets us see RNA polymerases in their native chromatin context along 30 kb fibers, revealing direct coordination — and anti-coordination — between neighbouring genes, enhancers and insulators.",
    img: "/d53c123a-2206-44d5-8b6f-3512215aee5b/AGTD+poster%404x.png",
    href: "/research#single-molecule",
    cite: "Tullius et al., Molecular Cell 2024",
  },
  {
    title: "How mitochondrial DNA is packaged",
    blurb:
      "Unlike the nuclear genome, human mtDNA compacts in an all-or-none fashion, with most nucleoids sitting in an inaccessible, inactive state. TFAM sets the fraction that stays open, acting by nucleation and spreading.",
    img: "/e0cb862a-b1e2-4026-af49-fb46fa3e9ff3/Isaac_Fig1.jpg",
    href: "/research#mitonuclear",
    cite: "Isaac et al., Nature Structural & Molecular Biology 2024",
  },
];

const description =
  "The Churchman Lab at Harvard Medical School studies how gene expression is regulated across the cell, from the nucleus to the mitochondria. We build quantitative sequencing methods — NET-seq, nano-COP, subcellular TimeLapse-seq, mtFiber-seq — to measure transcription, RNA processing, RNA flow between compartments, and mitonuclear coordination.";

const jsonld = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${site.url}/#website`,
  name: site.name,
  url: site.url,
  description,
  publisher: { "@id": `${site.url}/#lab` },
  about: [
    "gene expression",
    "transcription",
    "RNA polymerase II",
    "pre-mRNA splicing",
    "mitochondrial gene expression",
    "mitonuclear coordination",
    "RNA sequencing methods",
  ],
};
---

<Base title="Home" description={description} jsonld={jsonld} image={img("/84d82d85-dc45-4cf2-b950-0e00a3abad5c/Leidy+Churchman_Untitled_2024.jpg")}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Department of Genetics · Harvard Medical School</p>
        <h1>From the nucleus to mitochondria, we study the many layers of gene regulation.</h1>
        <p class="lede">
          A cell makes thousands of mRNAs every minute and controls every one of them — where it is made, how it is
          processed, how long it survives, and whether it is ever translated. We build quantitative methods that make
          those steps measurable, in both the nuclear and the mitochondrial genome.
        </p>
        <div class="btn-row">
          <a class="btn" href={u("/research")}>Read about our research</a>
          <a class="btn ghost" href={u("/join")}>Join the lab</a>
        </div>
      </div>
      <div class="hero-art">
        <img
          src={img("/84d82d85-dc45-4cf2-b950-0e00a3abad5c/Leidy+Churchman_Untitled_2024.jpg", 1000)}
          alt="Untitled (2024), a painting by Leidy Churchman"
          loading="eager"
        />
        <p class="figcap">Leidy Churchman, <em>Untitled</em> (2024)</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Recent work</p>
        <h2>Three things we have learned lately</h2>
      </div>
      <div class="cards">
        {highlights.map((h) => (
          <article class="card">
            <img src={img(h.img, 800)} alt="" loading="lazy" />
            <h3>{h.title}</h3>
            <p>{h.blurb}</p>
            <p class="figcap" style="margin-top:-.3rem">{h.cite}</p>
            <a class="more" href={u(h.href)}>How this fits together →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow">The lab</p>
        <h2>Biologists, physicists, chemists and computational scientists in one room</h2>
        <p class="prose">
          The lab has always been a mix. Stirling trained as a physicist; the people here now came in through
          biochemistry, neuroscience, chemistry, public health and computation. Methods development rewards that
          mix — most of our techniques exist because someone with the wrong background asked an obvious question.
        </p>
        <div class="btn-row">
          <a class="btn ghost" href={u("/team")}>Meet the team</a>
          <a class="btn ghost" href={u("/fun")}>See lab life</a>
        </div>
      </div>
      <div>
        <img
          src={img("/1590102780891-H84K8O9XST2P38738BZI/Sabrina+Shrestha+-+917B8AAD-B4E0-4F53-A344-6C25A60D26C7.jpeg", 900)}
          alt="Members of the Churchman lab together"
          loading="lazy"
          style="border-radius:3px"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Use our work</p>
        <h2>Methods, code and protocols, meant to be picked up by other labs</h2>
      </div>
      <div class="cards">
        <article class="card">
          <h3>GeneWalk</h3>
          <p>
            Identifies which functions of a gene actually matter in your biological context, by learning vector
            representations of genes and GO terms on a condition-specific network. <code>pip install genewalk</code>.
          </p>
          <a class="more" href={u("/tools/genewalk")}>Documentation and tutorial →</a>
        </article>
        <article class="card">
          <h3>Protocols</h3>
          <p>
            Published, benchtop-ready protocols for NET-seq, nano-COP, subcellular RNA-seq and mitoribosome
            profiling — with the corrections we have issued since publication.
          </p>
          <a class="more" href={u("/tools#protocols")}>Browse protocols →</a>
        </article>
        <article class="card">
          <h3>Publications</h3>
          <p>
            {pubs.sections.reduce((n, s) => n + s.items.length, 0)} papers, every one linked out to the journal or
            PubMed record, searchable by title, author, method or year.
          </p>
          <a class="more" href={u("/publications")}>All publications →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="box accent" style="display:grid;grid-template-columns:1.3fr .7fr;gap:36px;align-items:center">
        <div>
          <h2 style="margin-top:0">We are recruiting postdocs and rotation students</h2>
          <p style="margin-bottom:0;color:var(--ink-2)">
            We take people from biology, chemistry, physics, computer science, mathematics and engineering. If you
            want to build a method that does not exist yet and then use it to answer a question about gene
            regulation, this is a good place to do that.
          </p>
        </div>
        <div>
          <a class="btn" href={u("/join")}>What we look for &amp; how to apply</a>
        </div>
      </div>
    </div>
  </section>
</Base>
