---
import Base from "../layouts/Base.astro";
import RichText from "../components/RichText.astro";
import site from "../data/site.json";
import pubs from "../data/publications.json";
import content from "../data/pages/home.json";
import { u } from "../lib/path.js";

const img = (p) => u(p);

const description = content.seoDescription;

const jsonld = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${site.url}/#website`,
  name: site.name,
  url: site.url,
  description,
  publisher: { "@id": `${site.url}/#lab` },
  about: [
    "gene expression",
    "transcription",
    "RNA polymerase II",
    "pre-mRNA splicing",
    "mitochondrial gene expression",
    "mitonuclear coordination",
    "RNA sequencing methods",
  ],
};
---

<Base title="Home" description={description} jsonld={jsonld}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">{content.hero.eyebrow}</p>
        <h1>{content.hero.title}</h1>
        <RichText class="lede" html={content.hero.body} />
        <div class="btn-row">
          <a class="btn" href={u("/research")}>Read about our research</a>
          <a class="btn ghost" href={u("/join")}>Join the lab</a>
        </div>
      </div>
      <div class="hero-art">
        <img
          src={img(content.hero.image)}
          alt={content.hero.imageAlt}
          loading="eager"
        />
        <p class="figcap"><RichText inline html={content.hero.caption} /></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{content.recentWork.eyebrow}</p>
        <h2>{content.recentWork.title}</h2>
      </div>
      <div class="cards">
        {content.recentWork.items.map((h) => (
          <article class="card">
            <img src={img(h.image)} alt={h.imageAlt} loading="lazy" />
            <h3>{h.title}</h3>
            <RichText html={h.body} />
            <p class="figcap" style="margin-top:-.3rem">{h.citation}</p>
            <a class="more" href={u(h.href)}>{h.linkLabel}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow">{content.lab.eyebrow}</p>
        <h2>{content.lab.title}</h2>
        <RichText class="prose" html={content.lab.body} />
        <div class="btn-row">
          <a class="btn ghost" href={u("/team")}>Meet the team</a>
          <a class="btn ghost" href={u("/fun")}>See lab life</a>
        </div>
      </div>
      <div>
        <img
          src={img(content.lab.image)}
          alt={content.lab.imageAlt}
          loading="lazy"
          style="border-radius:3px"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{content.resources.eyebrow}</p>
        <h2>{content.resources.title}</h2>
      </div>
      <div class="cards">
        {content.resources.items.map((item) => (
          <article class="card">
            <h3>{item.title}</h3>
            <RichText html={item.body} />
            <a class="more" href={u(item.href)}>{item.linkLabel}</a>
          </article>
        ))}
        <article class="card">
          <h3>{content.resources.publicationsTitle}</h3>
          <p>
            {pubs.sections.reduce((n, s) => n + s.items.length, 0)} {content.resources.publicationsBody}
          </p>
          <a class="more" href={u("/publications")}>{content.resources.publicationsLinkLabel}</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="box accent" style="display:grid;grid-template-columns:1.3fr .7fr;gap:36px;align-items:center">
        <div>
          <h2 style="margin-top:0">{content.recruitment.title}</h2>
          <RichText class="recruitment-copy" html={content.recruitment.body} />
        </div>
        <div>
          <a class="btn" href={u("/join")}>{content.recruitment.buttonLabel}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .recruitment-copy { color: var(--ink-2); }
</style>
