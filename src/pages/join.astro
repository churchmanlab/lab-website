---
import Base from "../layouts/Base.astro";
import RichText from "../components/RichText.astro";
import site from "../data/site.json";
import content from "../data/pages/join.json";
import { u } from "../lib/path.js";

const img = (p) => u(p);
const pi = site.contacts[0];

const description = content.seoDescription;
---

<Base title="Join Us" description={description}>
  <section class="section join-hero">
    <div class="wrap join-hero-grid">
      <div>
        <p class="eyebrow">{content.hero.eyebrow}</p>
        <h1>{content.hero.title}</h1>
        <RichText class="lede prose" html={content.hero.body} />
        <div class="btn-row">
          <a class="btn" href="#apply">How to apply</a>
        </div>
        <nav class="jump-links" aria-label="On this page">
          <span>On this page</span>
          <a href="#positions">Open positions</a>
          <a href="#qualities">What we look for</a>
          <a href="#values">Our values</a>
        </nav>
      </div>
      <figure class="join-art">
        <img
          src={img(content.hero.image)}
          alt={content.hero.imageAlt}
          loading="eager"
          fetchpriority="high"
        />
        <figcaption class="figcap"><RichText inline html={content.hero.caption} /></figcaption>
      </figure>
    </div>
  </section>

  <section class="section" id="positions">
    <div class="wrap two-col">
      <div>
        <h2>Open positions</h2>

        {content.positions.map((position) => (
          <div class="qa">
            <h3>{position.title}</h3>
            <RichText html={position.body} />
          </div>
        ))}
      </div>

      <div>
        <div class="box accent" id="apply">
          <h3 style="margin-top:0">{content.application.title}</h3>
          <p style="font-size:.94rem"><strong>Postdocs.</strong> {content.application.postdocIntro} (<a href={`mailto:${pi.email}`}>{pi.email}</a>) with:</p>
          <ul style="font-size:.94rem;color:var(--ink-2);padding-left:1.1em">
            {content.application.postdocItems.map((item) => <li>{item}</li>)}
          </ul>
          <p style="font-size:.94rem">{content.application.postdocNote}</p>
          <p style="font-size:.94rem;margin-bottom:0">
            <strong>Rotation students.</strong> {content.application.rotationNote}
          </p>
        </div>

        <div class="box" style="margin-top:24px">
          <h4 style="margin-top:0">{content.application.processTitle}</h4>
          <RichText class="small-copy" html={content.application.processBody} />
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="qualities">
    <div class="wrap">
      <div class="section-head">
        <h2>{content.qualitiesTitle}</h2>
      </div>
      <div class="cards">
        {content.qualities.map((quality) => (
          <div>
            <h4>{quality.title}</h4>
            <RichText class="small-copy" html={quality.body} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>{content.ai.title}</h2>
        <RichText class="prose" html={content.ai.body} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap two-col">
      <div>
        <h2>{content.funding.title}</h2>
        <RichText class="prose" html={content.funding.body} />
      </div>
      <div>
        <h2>{content.alumni.title}</h2>
        <RichText class="prose" html={content.alumni.body} />
        <p style="margin-bottom:0">
          <a class="more" href={u("/team#alumni")}>See where everyone went →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="values">
    <div class="wrap">
      <div class="box">
        <h2 style="margin-top:0">{content.values.title}</h2>
        <RichText class="prose" html={content.values.body} />
      </div>
    </div>
  </section>

</Base>

<style>
  .small-copy { font-size: .94rem; color: var(--ink-2); }
</style>
