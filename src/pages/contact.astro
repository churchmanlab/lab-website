---
import Base from "../layouts/Base.astro";
import RichText from "../components/RichText.astro";
import site from "../data/site.json";
import content from "../data/pages/contact.json";
import { u } from "../lib/path.js";

const img = (p) => u(p);

const description = content.seoDescription;

const jsonld = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Contact — Churchman Lab",
  url: `${site.url}/contact`,
  description,
  about: { "@id": `${site.url}/#lab` },
};
---

<Base title="Contact" description={description} jsonld={jsonld}>
  <section class="section" style="padding-bottom:34px">
    <div class="wrap">
      <p class="eyebrow">{content.eyebrow}</p>
      <h1>{content.title}</h1>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap two-col">
      <div>
        <h2>{content.contactsTitle}</h2>
        {site.contacts.map((c) => (
          <div class="qa">
            <h3>{c.role}</h3>
            <p style="margin-bottom:0">
              {c.name} — <a href={`mailto:${c.email}`}>{c.email}</a>
            </p>
          </div>
        ))}

        <div class="box accent" style="margin-top:30px">
          <p style="margin-bottom:0"><RichText inline html={content.joiningNote} /></p>
        </div>
      </div>

      <div>
        <h2>{content.locationTitle}</h2>
        <p>
          {site.department}<br />
          {site.division}, {site.institution}<br />
          {site.address.line1}<br />
          {site.address.line2}<br />
          {site.address.city}, {site.address.state} {site.address.zip}
        </p>
        <p class="side-note">
          {content.travelNote} —
          <a href="https://www.masco.org/directions/m2-cambridge-harvard-shuttle">schedule</a>.
        </p>
        <p style="margin-top:1.5rem">
          <a class="btn ghost" href="https://maps.google.com/?q=77+Avenue+Louis+Pasteur,+Boston,+MA+02115">
            {content.mapButtonLabel}
          </a>
        </p>
        <img
          src={img("/images/site/contact-plates.jpg")}
          alt="Plates in the Churchman lab"
          loading="lazy"
          style="border-radius:3px;margin-top:28px"
        />
      </div>
    </div>
  </section>
</Base>
