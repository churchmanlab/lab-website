---
import Base from "../../layouts/Base.astro";
import RichText from "../../components/RichText.astro";
import site from "../../data/site.json";
import content from "../../data/pages/tools.json";
import { u } from "../../lib/path.js";

const img = (p) => u(p);

const description = content.seoDescription;
const protocols = content.protocolGroups;

const jsonld = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Tools and protocols — Churchman Lab",
  url: `${site.url}/tools`,
  description,
  about: { "@id": `${site.url}/#lab` },
  hasPart: protocols.flatMap((g) =>
    g.items.map((p) => ({ "@type": "HowTo", name: p.name, description: p.citation })),
  ),
};
---

<Base title="Tools & Protocols" description={description} jsonld={jsonld}>
  <section class="section" style="padding-bottom:34px">
    <div class="wrap">
      <p class="eyebrow">{content.eyebrow}</p>
      <h1>{content.title}</h1>
      <RichText class="lede prose" html={content.intro} />
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="cards">
        {content.cards.map((card) => (
          <article class="card">
            <img src={img(card.image)} alt={card.imageAlt} loading="lazy" />
            <h3>{card.title}</h3>
            <RichText html={card.body} />
            <a class="more" href={u(card.href)}>{card.linkLabel}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="protocols">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{content.protocolsEyebrow}</p>
        <h2>{content.protocolsTitle}</h2>
      </div>

      {protocols.map((g) => (
        <div style="margin-bottom:44px">
          <h3>{g.title}</h3>
          {g.items.map((p) => (
            <div class="qa">
              <h3 style="font-family:var(--serif);font-size:1.12rem">{p.name}</h3>
              <p style="font-size:.88rem;color:var(--ink-3);margin-bottom:.5rem">{p.citation}</p>
              <div class="pub-links">
                {p.links.map((l) => <a href={u(l.href)}>{l.label}</a>)}
              </div>
              {p.correction && (
                <div class="box" style="margin-top:14px;background:#fff8e1;border-color:#f0e0b0">
                  <h4 style="margin-top:0">Correction since publication</h4>
                  <RichText class="correction" html={p.correction} />
                </div>
              )}
            </div>
          ))}
        </div>
      ))}

    </div>
  </section>
</Base>

<style>
  .correction { font-size: .9rem; color: #5c4a00; }
</style>
