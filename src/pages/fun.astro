---
import Base from "../layouts/Base.astro";
import labLife from "../data/lab-life.json";
import { u } from "../lib/path.js";

const prepareAlbum = (album) => {
  const photos = album.groups.flatMap((group) =>
    group.files.map((file) => ({ file, credit: group.credit })),
  );
  const photoIndex = new Map();
  photos.forEach((photo, index) => photoIndex.set(photo.file, { ...photo, index }));
  const coverAlt = new Map(album.cover.map((photo) => [photo.file, photo.alt]));
  const photoPath = (file, size = "thumbs") => u(`/images/lab-life/${album.id}/${size}/${file}.jpg`);
  const cover = album.cover.map((photo) => {
    const index = photos.findIndex((candidate) => candidate.file === photo.file);
    return {
      ...photo,
      credit: index >= 0 ? photos[index].credit : "Churchman Lab",
      index: Math.max(index, 0),
    };
  });
  const clientPhotos = photos.map((photo, index) => ({
    full: photoPath(photo.file, "full"),
    alt: coverAlt.get(photo.file) || `${album.title} photograph ${index + 1} by ${photo.credit}`,
    caption: `${album.title} · Photo by ${photo.credit}`,
  }));

  const credits = [...new Set(album.groups.map((group) => group.credit))];

  return { ...album, photos, photoIndex, coverAlt, photoPath, cover, clientPhotos, credits };
};

const retreatAlbums = labLife.albums.map(prepareAlbum);
const eventAlbums = labLife.eventAlbums.map(prepareAlbum);
const eventAlbumById = new Map(eventAlbums.map((album) => [album.id, album]));
const pickEventAlbums = (ids) => ids.map((id) => eventAlbumById.get(id)).filter(Boolean);

const collections = [
  {
    id: "retreats",
    eyebrow: "Annual tradition · 2012–2025",
    title: "Lab retreats",
    description: "Chalk talks, shared meals, long hikes and the annual group portrait—one retreat for every year we gathered.",
    albums: retreatAlbums,
    previewAlbumIds: ["2025-retreat", "2012-retreat"],
  },
  {
    id: "milestones",
    eyebrow: "Thesis days & new candidates · 2019–2026",
    title: "Milestones & defenses",
    description: "Thesis defenses, candidacy dinners and the celebrations that follow big scientific milestones.",
    albums: pickEventAlbums([
      "2026-hope-defense",
      "2025-candidate-dinner",
      "2024-jake-defense",
      "2023-tommy-defense",
      "2019-blake-defense",
      "2019-heather-defense",
    ]),
    previewAlbumIds: ["2025-candidate-dinner", "2024-jake-defense"],
  },
  {
    id: "outings",
    eyebrow: "Boats, dinners & celebrations · 2013–2022",
    title: "Outings & celebrations",
    description: "Cruises, conferences, baby showers and send-offs from the life of the lab beyond Longwood Avenue.",
    albums: pickEventAlbums([
      "2022-charles-cruise",
      "2022-keystone",
      "2022-katja-baby-shower",
      "2021-lab-party",
      "2015-seth-farewell",
      "2013-harpoon-outing",
    ]),
    previewAlbumIds: ["2022-charles-cruise", "2013-harpoon-outing"],
  },
  {
    id: "beginnings",
    eyebrow: "The first years · 2011–2012",
    title: "Building the lab",
    description: "The original empty room, unpacking day and the small collection of photographs from the lab’s first year.",
    albums: pickEventAlbums(["2012-lab-move-in", "2011-first-year"]),
    previewAlbumIds: ["2012-lab-move-in", "2011-first-year"],
  },
].map((collection) => {
  const previews = collection.previewAlbumIds.map((albumId) => {
    const album = collection.albums.find((candidate) => candidate.id === albumId);
    const photo = album?.cover[0];
    return album && photo ? { src: album.photoPath(photo.file), alt: photo.alt } : null;
  }).filter(Boolean);

  return {
    ...collection,
    previews,
    photoCount: collection.albums.reduce((sum, album) => sum + album.photos.length, 0),
  };
});

const totalAlbums = collections.reduce((sum, collection) => sum + collection.albums.length, 0);
const totalPhotos = collections.reduce((sum, collection) => sum + collection.photoCount, 0);

const clientAlbums = Object.fromEntries(
  collections.flatMap((collection) => collection.albums.map((album) => [album.id, album.clientPhotos])),
);

const description =
  "Lab life in the Churchman Lab: annual retreats, celebrations, thesis defenses and boat trips on the Charles, from the lab's first day in 2011 to now.";
---

<Base title="Lab Life" description={description}>
  <section class="section" style="padding-bottom:34px">
    <div class="wrap">
      <p class="eyebrow">Lab life</p>
      <h1>Retreats, milestones and boats on the Charles</h1>
      <p class="lede prose">
        The lab has taken an annual retreat since 2012. Here's a glimpse of what life in the Churchman lab is like.
      </p>
    </div>
  </section>

  <section class="section collection-index">
    <div class="wrap">
      <div class="collection-index-head">
        <div>
          <p class="eyebrow">Through the years</p>
          <h2>Choose a collection</h2>
          <p class="prose">
            Browse a few highlights, then open any collection to explore its {totalAlbums} albums and {totalPhotos}
            photographs.
          </p>
        </div>
        <button class="btn collection-load-all" type="button" data-load-all-collections>
          Open all collections
        </button>
      </div>

      <div class="collection-cards">
        {collections.map((collection) => (
          <button
            class="collection-card"
            type="button"
            data-collection-toggle={collection.id}
            aria-controls={`collection-${collection.id}`}
            aria-expanded="false"
            aria-label={`Explore ${collection.title}`}
          >
            <span class="collection-card-preview" aria-hidden="true">
              {collection.previews.map((preview) => (
                <img src={preview?.src} alt="" loading="lazy" decoding="async" />
              ))}
            </span>
            <span class="eyebrow">{collection.eyebrow}</span>
            <strong>{collection.title}</strong>
            <span class="collection-card-description">{collection.description}</span>
            <span class="collection-card-meta">{collection.albums.length} albums <span aria-hidden="true">·</span> {collection.photoCount} photographs</span>
            <span class="collection-card-action" data-collection-action>Explore collection <span aria-hidden="true">↓</span></span>
          </button>
        ))}
      </div>
    </div>
  </section>

  {collections.map((collection) => (
    <div
      class="album-collection"
      id={`collection-${collection.id}`}
      data-collection-panel={collection.id}
      hidden
    >
      <section class="section album-collection-intro">
        <div class="wrap">
          <div class="album-collection-intro-head">
            <div>
              <p class="eyebrow">{collection.eyebrow}</p>
              <h2 tabindex="-1" data-collection-heading>{collection.title}</h2>
              <p class="prose">{collection.description}</p>
            </div>
            <button class="btn collection-back" type="button" data-collection-back={collection.id}>
              Back to collections <span aria-hidden="true">↑</span>
            </button>
          </div>
        </div>
      </section>

      {collection.albums.map((album) => (
        <section class="section lab-life-album">
          <div class="wrap">
            <div class="album-head">
              <div>
                <h2>{album.title}</h2>
                <p class="album-meta">{album.date} <span aria-hidden="true">·</span> {album.location}</p>
                <p class="prose">{album.description}</p>
              </div>
              <button class="btn album-open" type="button" data-album-id={album.id} data-photo-index="0">
                Open album <span aria-hidden="true">→</span>
              </button>
            </div>

            <div class:list={["album-cover", { "is-two-up": album.cover.length === 2 }]} aria-label={`${album.title} highlights`}>
              {album.cover.map((photo, index) => (
                <button
                  class:list={["album-cover-photo", { "is-main": index === 0 }]}
                  type="button"
                  data-album-id={album.id}
                  data-photo-index={photo.index}
                  aria-label={`Open album at: ${photo.alt}`}
                >
                  <img
                    data-src={album.photoPath(photo.file)}
                    alt={photo.alt}
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              ))}
            </div>

            <p class="album-credit">
              {album.photos.length} photographs <span aria-hidden="true">·</span> Photos by {album.credits.join(", ")}
            </p>

            <details class="album-drawer">
              <summary>Browse all {album.photos.length} photographs</summary>
              <div class="album-groups">
                {album.groups.map((group) => {
                  const creditId = `credit-${album.id}-${group.credit.replaceAll(" ", "-").toLowerCase()}`;
                  return (
                    <section class="album-group" aria-labelledby={creditId}>
                      <h3 id={creditId}>Photos by {group.credit}</h3>
                      <div class="album-grid">
                        {group.files.map((file) => {
                          const photo = album.photoIndex.get(file);
                          return (
                            <button
                              class="album-thumb"
                              type="button"
                              data-album-id={album.id}
                              data-photo-index={photo?.index || 0}
                              aria-label={`Open photograph by ${group.credit}`}
                            >
                              <img
                                data-src={album.photoPath(file)}
                                alt={album.coverAlt.get(file) || `${album.title} photograph by ${group.credit}`}
                                loading="lazy"
                                decoding="async"
                              />
                            </button>
                          );
                        })}
                      </div>
                    </section>
                  );
                })}
              </div>
            </details>
          </div>
        </section>
      ))}
    </div>
  ))}

  <dialog class="photo-lightbox" id="lab-life-lightbox" aria-label="Lab life photo viewer">
    <div class="lightbox-shell">
      <button class="lightbox-close" type="button" data-lightbox-close aria-label="Close photo viewer">×</button>
      <button class="lightbox-nav lightbox-prev" type="button" data-lightbox-prev aria-label="Previous photograph">←</button>
      <figure class="lightbox-figure">
        <img data-lightbox-image alt="" />
        <figcaption class="lightbox-caption" aria-live="polite">
          <span data-lightbox-caption></span>
          <span data-lightbox-counter></span>
        </figcaption>
      </figure>
      <button class="lightbox-nav lightbox-next" type="button" data-lightbox-next aria-label="Next photograph">→</button>
    </div>
  </dialog>

  <script id="lab-life-photo-data" type="application/json" set:html={JSON.stringify(clientAlbums)}></script>
  <script>
    const dataNode = document.querySelector("#lab-life-photo-data");
    const dialog = document.querySelector("#lab-life-lightbox");
    const image = dialog?.querySelector("[data-lightbox-image]");
    const caption = dialog?.querySelector("[data-lightbox-caption]");
    const counter = dialog?.querySelector("[data-lightbox-counter]");
    const albums = dataNode ? JSON.parse(dataNode.textContent || "{}") : {};

    const loadDeferredImages = (root, selector = "img[data-src]") => {
      root.querySelectorAll(selector).forEach((node) => {
        if (!(node instanceof HTMLImageElement) || !node.dataset.src) return;
        node.src = node.dataset.src;
        delete node.dataset.src;
      });
    };

    const collectionButtons = [...document.querySelectorAll("[data-collection-toggle]")];
    const setCollectionOpen = (button, open, bringIntoView = false) => {
      if (!(button instanceof HTMLButtonElement)) return;
      const panelId = button.getAttribute("aria-controls");
      const panel = panelId ? document.getElementById(panelId) : null;
      if (!(panel instanceof HTMLElement)) return;

      panel.hidden = !open;
      button.setAttribute("aria-expanded", String(open));
      const action = button.querySelector("[data-collection-action]");
      if (action instanceof HTMLElement) action.innerHTML = open ? "Close collection ↑" : "Explore collection ↓";
      if (open) {
        loadDeferredImages(panel, ".album-cover img[data-src]");
        if (bringIntoView) {
          requestAnimationFrame(() => {
            const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            panel.scrollIntoView({ behavior: reducedMotion ? "auto" : "smooth", block: "start" });
            const heading = panel.querySelector("[data-collection-heading]");
            if (heading instanceof HTMLElement) heading.focus({ preventScroll: true });
          });
        }
      }
    };

    collectionButtons.forEach((button) => {
      button.addEventListener("click", () => {
        setCollectionOpen(button, button.getAttribute("aria-expanded") !== "true", true);
      });
    });

    document.querySelectorAll("[data-collection-back]").forEach((backButton) => {
      backButton.addEventListener("click", () => {
        const collectionId = backButton.getAttribute("data-collection-back");
        const collectionButton = collectionButtons.find(
          (button) => button.getAttribute("data-collection-toggle") === collectionId,
        );
        if (!(collectionButton instanceof HTMLButtonElement)) return;
        setCollectionOpen(collectionButton, false);
        collectionButton.scrollIntoView({ behavior: "smooth", block: "center" });
        collectionButton.focus({ preventScroll: true });
      });
    });

    document.querySelector("[data-load-all-collections]")?.addEventListener("click", (event) => {
      collectionButtons.forEach((button) => setCollectionOpen(button, true));
      if (event.currentTarget instanceof HTMLButtonElement) {
        event.currentTarget.textContent = "All collections are open";
        event.currentTarget.disabled = true;
      }
    });

    document.querySelectorAll("details.album-drawer").forEach((drawer) => {
      drawer.addEventListener("toggle", () => {
        if (drawer instanceof HTMLDetailsElement && drawer.open) loadDeferredImages(drawer);
      });
    });

    if (
      dialog instanceof HTMLDialogElement &&
      image instanceof HTMLImageElement &&
      caption instanceof HTMLElement &&
      counter instanceof HTMLElement
    ) {
      let photos = [];
      let current = 0;
      let lastTrigger = null;
      let touchStartX = 0;

      const showPhoto = (requested) => {
        current = (requested + photos.length) % photos.length;
        const photo = photos[current];
        image.src = photo.full;
        image.alt = photo.alt;
        caption.textContent = photo.caption;
        counter.textContent = `${current + 1} of ${photos.length}`;

        for (const offset of [-1, 1]) {
          const neighbor = photos[(current + offset + photos.length) % photos.length];
          const preload = new Image();
          preload.src = neighbor.full;
        }
      };

      const openAlbum = (trigger) => {
        photos = albums[trigger.dataset.albumId || ""] || [];
        if (!photos.length) return;
        lastTrigger = trigger;
        showPhoto(Number(trigger.dataset.photoIndex || 0));
        if (!dialog.open) dialog.showModal();
      };

      document.querySelectorAll("[data-album-id][data-photo-index]").forEach((trigger) => {
        trigger.addEventListener("click", () => openAlbum(trigger));
      });

      dialog.querySelector("[data-lightbox-close]")?.addEventListener("click", () => dialog.close());
      dialog.querySelector("[data-lightbox-prev]")?.addEventListener("click", () => showPhoto(current - 1));
      dialog.querySelector("[data-lightbox-next]")?.addEventListener("click", () => showPhoto(current + 1));

      dialog.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") showPhoto(current - 1);
        if (event.key === "ArrowRight") showPhoto(current + 1);
      });
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener("close", () => {
        image.removeAttribute("src");
        lastTrigger?.focus();
      });
      dialog.addEventListener("touchstart", (event) => {
        touchStartX = event.changedTouches[0]?.screenX || 0;
      }, { passive: true });
      dialog.addEventListener("touchend", (event) => {
        const distance = (event.changedTouches[0]?.screenX || 0) - touchStartX;
        if (Math.abs(distance) > 50) showPhoto(current + (distance < 0 ? 1 : -1));
      }, { passive: true });
    }
  </script>
</Base>
