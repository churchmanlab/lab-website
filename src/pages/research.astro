---
import Base from "../layouts/Base.astro";
import RichText from "../components/RichText.astro";
import site from "../data/site.json";
import content from "../data/pages/research.json";
import { u } from "../lib/path.js";

const img = (p) => u(p);

const description = content.seoDescription;

const jsonld = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Research — Churchman Lab",
  url: `${site.url}/research`,
  description,
  about: { "@id": `${site.url}/#lab` },
  mainEntity: {
    "@type": "ResearchProject",
    name: "Gene regulation from the nucleus to the mitochondria",
    description,
    parentOrganization: { "@id": `${site.url}/#lab` },
  },
};
---

<Base title="Research" description={description} jsonld={jsonld}>
  <section class="section research-intro">
    <div class="wrap research-intro-grid">
      <div class="research-intro-heading">
        <p class="eyebrow">{content.intro.eyebrow}</p>
        <h1>{content.intro.title}</h1>
      </div>
      <RichText class="prose research-intro-copy" html={content.intro.body} />
      <figure class="research-intro-art">
        <div class="research-art-crop">
          <img
            src={img(content.intro.image)}
            alt={content.intro.imageAlt}
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption class="figcap"><RichText inline html={content.intro.caption} /></figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ nuclear mRNA life cycle ============ -->
  <section class="section" id="mrna-life-cycle">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{content.nuclear.eyebrow}</p>
        <h2>{content.nuclear.title}</h2>
        <RichText class="lede" html={content.nuclear.lede} />
      </div>

      <img
        class="research-cartoon research-cartoon-wide"
        src={img(content.nuclear.image)}
        alt={content.nuclear.imageAlt}
        loading="lazy"
        style="border-radius:3px;margin-bottom:44px"
      />

      {content.nuclear.topics.map((topic, index) => (
        <div style={index > 0 ? "margin-top:52px" : undefined}>
          <h3>{topic.title}</h3>
          <RichText class="prose" html={topic.body} />
          <div class="box" style={`margin-top:${index === 0 ? 34 : 20}px`}>
            <h4>Open questions</h4>
            <RichText html={topic.openQuestions} style="color:var(--ink-2)" />
            {topic.backgroundReading && (
              <p style="margin:.9rem 0 0;font-size:.86rem;color:var(--ink-3)">
                Background reading: <RichText inline html={topic.backgroundReading} />
              </p>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ RNA flow ============ -->
  <section class="section" id="rna-flow">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{content.rnaFlow.eyebrow}</p>
        <h2>{content.rnaFlow.title}</h2>
      </div>
      <div class="two-col">
        <RichText class="prose" html={content.rnaFlow.body} />
        <div>
          <img
            class="research-cartoon"
            src={img(content.rnaFlow.image)}
            alt={content.rnaFlow.imageAlt}
            loading="lazy"
            style="border-radius:3px"
          />
        </div>
      </div>

      <div class="box" style="margin-top:34px">
        <h4>Open questions</h4>
        <RichText html={content.rnaFlow.openQuestions} style="color:var(--ink-2)" />
        <p style="margin:.9rem 0 0;font-size:.86rem;color:var(--ink-3)">
          Background reading: <RichText inline html={content.rnaFlow.backgroundReading} />
        </p>
      </div>
    </div>
  </section>

  <!-- ============ mitonuclear ============ -->
  <section class="section" id="mitonuclear">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{content.mitonuclear.eyebrow}</p>
        <h2>{content.mitonuclear.title}</h2>
        <RichText class="lede" html={content.mitonuclear.lede} />
      </div>

      <img
        class="research-cartoon research-cartoon-wide"
        src={img(content.mitonuclear.heroImage)}
        alt={content.mitonuclear.heroImageAlt}
        loading="lazy"
        style="border-radius:3px;margin-bottom:44px"
      />

      <div class="two-col">
        <RichText class="prose" html={content.mitonuclear.overview} />
        <div>
          <img
            class="research-cartoon"
            src={img(content.mitonuclear.diagramImage)}
            alt={content.mitonuclear.diagramImageAlt}
            loading="lazy"
            style="border-radius:3px;margin-bottom:24px"
          />
          <img class="research-cartoon research-cartoon-half" src={img(content.mitonuclear.secondaryImage)} alt={content.mitonuclear.secondaryImageAlt} loading="lazy" style="border-radius:3px" />
        </div>
      </div>

      {content.mitonuclear.topics.map((topic, index) => (
        <div style={`margin-top:${index === 0 ? 52 : 44}px`}>
          <h3>{topic.title}</h3>
          <RichText class="prose" html={topic.body} />
        </div>
      ))}

      <div class="box" style="margin-top:24px">
        <h4>Open questions</h4>
        <RichText html={content.mitonuclear.openQuestions} style="color:var(--ink-2)" />
        <p style="margin:.9rem 0 0;font-size:.86rem;color:var(--ink-3)">
          Background reading: <RichText inline html={content.mitonuclear.backgroundReading} />
        </p>
      </div>
    </div>
  </section>

  <!-- ============ mitochondrial single molecule ============ -->
  <section class="section" id="mtfiber-seq">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{content.mtFiber.eyebrow}</p>
        <h2>{content.mtFiber.title}</h2>
      </div>
      <div class="two-col">
        <RichText class="prose" html={content.mtFiber.body} />
        <div>
          <img
            src={img(content.mtFiber.image)}
            alt={content.mtFiber.imageAlt}
            loading="lazy"
            style="border-radius:3px"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="btn-row">
        <a class="btn" href={u("/join")}>Work on these questions with us</a>
        <a class="btn ghost" href={u("/publications")}>See all publications</a>
        <a class="btn ghost" href={u("/tools")}>Methods, code and protocols</a>
      </div>
    </div>
  </section>

  <style>
    .research-cartoon {
      width: 84%;
      margin-left: auto;
      margin-right: auto;
    }

    .research-cartoon-wide {
      width: 42%;
      max-width: 460px;
    }

    .research-cartoon-half {
      width: 42%;
    }

    @media (max-width: 700px) {
      .research-cartoon-wide,
      .research-cartoon-half {
        width: 72%;
      }
    }
  </style>
</Base>
