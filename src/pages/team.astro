---
import Base from "../layouts/Base.astro";
import site from "../data/site.json";
import team from "../data/team.json";
import { u } from "../lib/path.js";

// Photos migrated into the repo start with /images/; everything else is still on the
// Squarespace CDN. Migrating a photo is now just a matter of changing the path.
const img = (p, w = 600) => (p.startsWith("/images/") ? u(p) : `${site.cdn}${p}?format=${w}w`);

const description =
  "The Churchman Lab is a multidisciplinary group of biologists, chemists, physicists and computational scientists at Harvard Medical School, led by Professor L. Stirling Churchman. Current members and lab alumni.";

const jsonld = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Team — Churchman Lab",
  url: `${site.url}/team`,
  description,
  about: { "@id": `${site.url}/#lab` },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: team.current.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "Person",
        name: p.name,
        jobTitle: p.role,
        ...(p.email ? { email: p.email } : {}),
        // Collaborators are affiliated with their home lab as well as with ours, so an
        // assistant asked "who is Jimmy Ly?" gets both institutions rather than half the story.
        affiliation: p.homeLab
          ? [
              { "@id": `${site.url}/#lab` },
              {
                "@type": "ResearchOrganization",
                name: p.homeLab,
                ...(p.homeLabUrl ? { url: p.homeLabUrl } : {}),
                ...(p.homeLabInstitution
                  ? { parentOrganization: { "@type": "Organization", name: p.homeLabInstitution } }
                  : {}),
              },
            ]
          : { "@id": `${site.url}/#lab` },
        ...(p.award ? { award: p.award } : {}),
        ...(p.pi ? { "@id": `${site.url}/stirling#person` } : {}),
      },
    })),
  },
};
---

<Base title="Team" description={description} jsonld={jsonld}>
  <section class="section" style="padding-bottom:36px">
    <div class="wrap">
      <p class="eyebrow">Team</p>
      <h1>Our team</h1>
      <p class="lede prose">
        A multidisciplinary group of scientists who love gene expression, mitochondria and RNA — with training in
        biology, chemistry, physics, neuroscience, public health and computation.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="people">
        {team.current.map((p) => (
          <article class="person">
            <img src={img(p.photo)} alt={p.name} loading="lazy" />
            {/* kept on one line: a line break here renders as a space before the comma */}
            <p class="nm">{p.href ? <a href={u(p.href)} style="color:inherit">{p.name}</a> : p.name}{p.degree && <span style="font-weight:400;color:var(--ink-3)">, {p.degree}</span>}</p>
            <p class="rl">{p.role}</p>
            {p.homeLab && (
              <p class="dt">Home lab: {p.homeLabUrl ? <a href={p.homeLabUrl}>{p.homeLab}</a> : p.homeLab}{p.homeLabInstitution && <span>, {p.homeLabInstitution}</span>}</p>
            )}
            {p.detail && <p class="dt">{p.detail}</p>}
            {p.award && <p class="aw">{p.award}</p>}
            {p.email && (
              <p class="em"><a href={`mailto:${p.email}`}>{p.email}</a></p>
            )}
          </article>
        ))}
      </div>

      <div class="box accent" style="margin-top:52px">
        <h3 style="margin-top:0">There is room for one more</h3>
        <p style="margin-bottom:0;color:var(--ink-2)">
          We are recruiting postdoctoral fellows and taking rotation students.
          <a href={u("/join")}>See what we look for and how to apply →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="alumni">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Alumni</p>
        <h2>Where people went next</h2>
        <p class="prose">
          One of the more useful things a lab website can tell a prospective trainee is what happened to everyone
          who came before them.
        </p>
      </div>

      <h3>Former postdocs</h3>
      <ul class="alumni-list">
        {team.alumniPostdocs.map((a) => (
          <li>
            <span class="nm">{a.href ? <a href={u(a.href)}>{a.name}</a> : a.name}</span>
            {a.now && <span class="now">{a.now}</span>}
          </li>
        ))}
      </ul>

      <h3 style="margin-top:40px">Former graduate students</h3>
      <ul class="alumni-list">
        {team.alumniStudents.map((a) => (
          <li>
            <span class="nm">{a.href ? <a href={u(a.href)}>{a.name}</a> : a.name}</span>
            {a.now && <span class="now">{a.now}</span>}
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
