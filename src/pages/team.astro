---
import Base from "../layouts/Base.astro";
import RichText from "../components/RichText.astro";
import site from "../data/site.json";
import team from "../data/team.json";
import content from "../data/pages/team.json";
import { u } from "../lib/path.js";

const img = (p) => u(p);
const initials = (name) =>
  name
    .split(/\s+/)
    .map((part) => part[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();

const description = content.seoDescription;

const jsonld = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Team — Churchman Lab",
  url: `${site.url}/team`,
  description,
  about: { "@id": `${site.url}/#lab` },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: team.current.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "Person",
        name: p.name,
        jobTitle: p.role,
        ...(p.email ? { email: p.email } : {}),
        // Collaborators are affiliated with their home lab as well as with ours, so an
        // assistant asked "who is Jimmy Ly?" gets both institutions rather than half the story.
        affiliation: p.homeLab
          ? [
              { "@id": `${site.url}/#lab` },
              {
                "@type": "ResearchOrganization",
                name: p.homeLab,
                ...(p.homeLabUrl ? { url: p.homeLabUrl } : {}),
                ...(p.homeLabInstitution
                  ? { parentOrganization: { "@type": "Organization", name: p.homeLabInstitution } }
                  : {}),
              },
            ]
          : { "@id": `${site.url}/#lab` },
        ...(p.award ? { award: p.award } : {}),
        ...(p.pi ? { "@id": `${site.url}/stirling#person` } : {}),
      },
    })),
  },
};
---

<Base title="Team" description={description} jsonld={jsonld}>
  <section class="section" style="padding-bottom:36px">
    <div class="wrap">
      <p class="eyebrow">{content.eyebrow}</p>
      <h1>{content.title}</h1>
      <RichText class="lede prose" html={content.intro} />
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="people">
        {team.current.map((p) => (
          <article class="person">
            {p.photo ? (
              <img src={img(p.photo)} alt={p.name} loading="lazy" />
            ) : (
              <div class="portrait-placeholder" role="img" aria-label={`${p.name} — photo forthcoming`}>
                {initials(p.name)}
              </div>
            )}
            {/* kept on one line: a line break here renders as a space before the comma */}
            <p class="nm">{p.href ? <a href={u(p.href)} style="color:inherit">{p.name}</a> : p.name}{p.degree && <span style="font-weight:400;color:var(--ink-3)">, {p.degree}</span>}</p>
            <p class="rl">{p.role}</p>
            {p.homeLab && (
              <p class="dt">Home lab: {p.homeLabUrl ? <a href={p.homeLabUrl}>{p.homeLab}</a> : p.homeLab}{p.homeLabInstitution && <span>, {p.homeLabInstitution}</span>}</p>
            )}
            {p.detail && <p class="dt">{p.detail}</p>}
            {p.award && <p class="aw">{p.award}</p>}
            {p.email && (
              <p class="em"><a href={`mailto:${p.email}`}>{p.email}</a></p>
            )}
          </article>
        ))}
      </div>

      <div class="box accent" style="margin-top:52px">
        <h3 style="margin-top:0">{content.recruitmentTitle}</h3>
        <p style="margin-bottom:0;color:var(--ink-2)">
          {content.recruitmentBody}{" "}
          <a href={u("/join")}>See what we look for and how to apply →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="alumni">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{content.alumniEyebrow}</p>
        <h2>{content.alumniTitle}</h2>
      </div>

      <h3>Former postdocs</h3>
      <ul class="alumni-list">
        {team.alumniPostdocs.map((a) => (
          <li>
            <span class="nm">{a.href ? <a href={u(a.href)}>{a.name}</a> : a.name}</span>
            {a.now && <span class="now">{a.now}</span>}
          </li>
        ))}
      </ul>

      <h3 style="margin-top:40px">Former graduate students</h3>
      <ul class="alumni-list">
        {team.alumniStudents.map((a) => (
          <li>
            <span class="nm">{a.href ? <a href={u(a.href)}>{a.name}</a> : a.name}</span>
            {a.now && <span class="now">{a.now}</span>}
          </li>
        ))}
      </ul>

      <h3 style="margin-top:40px">Former undergraduate students</h3>
      <ul class="alumni-list">
        {team.alumniUndergraduates.map((a) => (
          <li>
            <span class="nm">{a.href ? <a href={a.href}>{a.name}</a> : a.name}</span>
            {a.award && <span class="path"><b>Thesis award:</b> {a.award}</span>}
            {a.program && <span class="path"><b>Graduate program:</b> {a.program}</span>}
            {a.now && <span class="path"><b>Now:</b> {a.now}</span>}
          </li>
        ))}
      </ul>

      <h3 style="margin-top:40px">Former technicians and lab managers</h3>
      <ul class="alumni-list">
        {team.alumniTechnicians.map((a) => (
          <li>
            <span class="nm">{a.href ? <a href={a.href}>{a.name}</a> : a.name}</span>
            <span class="path"><b>Graduate program:</b> {a.program}</span>
            <span class="path"><b>Now:</b> {a.now}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
