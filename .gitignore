# heavy originals; the rendered thumbnails in public/images/pubs/ ARE committed.
/pdfs/

# Local exports from Photos used to build the web-sized lab-life albums.
.photo-import/


# scratch folder for files staged for deletion (safe to remove)
_to_delete/
